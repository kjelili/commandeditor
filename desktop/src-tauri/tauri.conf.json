{
  "package": {
    "productName": "CommandEditor",
    "version": "1.1.0"
  },
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "http://localhost:3000",
    "distDir": "../../out",
    "withGlobalTauri": true
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "dialog": {
        "all": false,
        "open": true,
        "save": true
      },
      "globalShortcut": {
        "all": true
      },
      "notification": {
        "all": true
      },
      "clipboard": {
        "all": false,
        "writeText": true,
        "readText": true
      },
      "window": {
        "all": false,
        "show": true,
        "hide": true,
        "setFocus": true,
        "startDragging": true,
        "print": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.commandeditor.desktop",
      "publisher": "CommandEditor",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "resources": [
        "resources/*"
      ],
      "copyright": "\u00a9 2026 CommandEditor",
      "category": "Productivity",
      "shortDescription": "Professional PDF editing",
      "longDescription": "CommandEditor Desktop brings professional PDF editing to your native desktop with GPU acceleration, system integration, and offline-first architecture.",
      "deb": {
        "depends": [
          "libwebkit2gtk-4.0-37",
          "libgtk-3-0"
        ]
      },
      "macOS": {
        "frameworks": [],
        "minimumSystemVersion": "10.13",
        "license": "MIT",
        "entitlements": "entitlements.plist"
      },
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    },
    "windows": [
      {
        "title": "CommandEditor",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: https://asset.localhost; font-src 'self' data:; connect-src 'self' data: blob: https: wss:; worker-src 'self' blob:; child-src blob:"
    }
  }
}
